/target
**/*.rs.bk
Cargo.lock.bak

# The mainnet block corpus is generated, not committed: see
# tests/corpus/README.md and scripts/fetch-corpus.py.
/tests/corpus/blocks/mainnet/

# Likewise the per-block weight ranges and the HF 16-17 unlock block ids:
# see scripts/fetch-weights.py and scripts/fetch-unlock.py.
/tests/corpus/weights/
/tests/corpus/unlock/

# --- from the repository's own template ---

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# cargo mutants writes its mutation-testing data here
**/mutants.out*/

# rustfmt backups
**/*.rs.bk

# Editor and OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db

# Anything that looks like a wallet or a key must never be committed. The test
# suite builds its wallets in a scratch directory; a file matching these in the
# working tree is somebody's real one.
*.keys
*.address.txt
*.rscache
/wallets/
